# Copy to .env.local and fill in.
# Local stack: run `pnpm supabase start` and use the values it prints.
# Hosted project: Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Show the "Continue with Google" button. Needs the Google provider enabled in
# supabase/config.toml (locally) or the Supabase dashboard (hosted).
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# Feature flags (src/lib/flags.ts): off unless exactly "true". On Vercel, set
# them per environment and redeploy.
# Comparar's "Cara a cara" in place of "Puntos por categoría".
FEATURE_COMPARE_HEAD_TO_HEAD=false
# "¿Sabías que…?": the crow on the insert (and at the end of Inicio on phones) tells facts.
FEATURE_DID_YOU_KNOW=false
